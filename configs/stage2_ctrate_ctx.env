# Context pathway on the ADULT schema. Sourced AFTER configs/stage2.env, which
# carries the published adult recipe; nothing here overrides that recipe, because
# the whole point of this run is that the recipe is not what changed.
#
# 30 queries, not 39: the adult bank is 10 anatomy + 18 pathology + 2 global. The
# context bank around it becomes 49 slots over 31 rows (18 conditioned pathology
# slots weight-tied to the general ones, plus the single clinical global row).
# SlotLayout derives all of that from len(PATHOLOGIES), so the only thing that has
# to be stated is the schema.
RAC_USE_CONTEXT_QFORMER=1
RAC_QFORMER_QUERIES=30

RAC_CTX_C1=1
RAC_CTX_FILM_EPS=0.2
RAC_CTX_MAX_IND_LEN=64
RAC_CTX_C2=1
# -2.0 and a 20x multiplier, both carried over from the pediatric ladder for the
# same reason: at -6 the softplus gradient is sigma(-6)=0.0025 and beta cannot
# move within a run, and zero-init modules trained at the warm-start rate never
# leave zero. That was measured, not guessed -- beta moved 0.00012 in a full run.
# The code DEFAULTS are -6.0 and 1.0, so an empty or unsourced file silently
# reproduces exactly the two faults that made the first ladder measure nothing.
RAC_CTX_BETA_INIT=-2.0
RAC_CTX_LR_MULT=20.0
RAC_CTX_PTOK_WEIGHT=0.5
RAC_CTX_SELFATTN=split
RAC_CTX_ZIND_COMBINE=mean
RAC_CTX_ASSERT_INVARIANCE=1
RAC_CTX_ROLE_STATS=1

# 48.8% of CT-RATE volumes carry an indication. Dropout applies to the ones that
# HAVE one; rows that are already vacuous or absent are not counted as dropped,
# or the effective rate here would be about 0.85 and nothing would report it.
RAC_IND_DROPOUT=0.3
RAC_CF_PROB=0.25
RAC_CF_SAME_COHORT=1
RAC_CF_WEIGHT=0.5
RAC_CF_TAU=0.5

RAC_CONTEXT_CSV=/temp_work/ch278233/CONTEXT/indication.csv
RAC_DEMOGRAPHICS_CSV=/temp_work/ch278233/CONTEXT/demographics.csv
RAC_EVAL_IND_MODE=true
RAC_CTX_DEBUG=0
