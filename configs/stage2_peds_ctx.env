# Phase 1 -- Context-Routed CT. Everything in stage2_peds.env still applies;
# source that FIRST, then this file, so these lines override rather than replace.
#
#   set -a; . configs/stage2_peds.env; . configs/stage2_peds_ctx.env; set +a
#
# The design this implements is docs/CONTEXT_ROUTED_CT.{tr,en}.md. Read §04
# (isolation) before changing anything below: several of these values are load
# bearing rather than tuned.

# ---- the bank -------------------------------------------------------------
RAC_USE_CONTEXT_QFORMER=1
# RAC_QFORMER_QUERIES stays 39. It now names the UNCONDITIONED bank, which is
# what the warm-start checkpoint holds and what Z_gen averages. The full bank is
# 67 slots over 40 parameter rows; train_stage2.py refuses to start if this
# number and the layout disagree.
RAC_QFORMER_QUERIES=39

# ---- C1: indication -> query conditioning ---------------------------------
RAC_CTX_C1=1
# gamma = 1 + eps*tanh(.). eps must stay well below 1: at eps=1 a saturated tanh
# drives gamma to 0 and erases the query outright, which would make the
# "residual, the query is never erased" guarantee false for exactly the classes
# the indication considers irrelevant.
RAC_CTX_FILM_EPS=0.2
# The measured pediatric indication is median 24 words, p90 47. 64 tokens covers
# p90 with room for wordpiece splitting; the long tail is where pasted prior
# reports live and is deliberately truncated.
RAC_CTX_MAX_IND_LEN=64

# ---- C2: relevance weighting ----------------------------------------------
RAC_CTX_C2=1
# w = 1 + softplus(b)*r. softplus(-6) = 0.0025, so the weighting starts
# essentially uniform and has to earn its way up. b itself is trained.
RAC_CTX_BETA_INIT=-6.0
RAC_CTX_PTOK_WEIGHT=0.5

# ---- isolation ------------------------------------------------------------
# "split" runs the unconditioned rows as their own attention with no mask: the
# same op, shape and kernel as the 39-query model, which is what keeps the step-0
# identity exact rather than approximate. "mask" is the cross-check path; the two
# must agree, and tools/test_qformer_slots.py asserts it.
RAC_CTX_SELFATTN=split
# mean keeps ||Z_ind|| on the same scale as ||Z_gen||, so the |W_ind|/|W_gen|
# diagnostic printed every LOG_EVERY is readable. "add" is an ablation arm.
RAC_CTX_ZIND_COMBINE=mean
# Re-checks Z_gen invariance at every validation. Cheap (one extra forward on the
# validation set) and it catches a regression in the split, the pooling or the
# role_row that no AUC would reveal.
RAC_CTX_ASSERT_INVARIANCE=1
RAC_CTX_ROLE_STATS=1

# ---- indication bias controls ---------------------------------------------
# 30% of eligible rows train with no indication. Rows that are already vacuous
# or absent are NOT counted here -- counting them would put the effective rate on
# the adult half, where 75.9% of CT-RATE indications are vacuous, far above 0.30.
RAC_IND_DROPOUT=0.3
# Counterfactual: same CT, a different patient's indication. Never drawn against
# a dropped row, never across cohorts.
RAC_CF_PROB=0.25
RAC_CF_SAME_COHORT=1
RAC_CF_WEIGHT=0.5
# Only classes the indication considers irrelevant are held stable. Holding the
# relevant ones stable would penalise the mechanism for working.
RAC_CF_TAU=0.5

# ---- data -----------------------------------------------------------------
RAC_CONTEXT_CSV=/temp_work/ch278233/CONTEXT/indication.csv
RAC_DEMOGRAPHICS_CSV=/temp_work/ch278233/CONTEXT/demographics.csv
# The 54 volumes whose report channel is contaminated: no section header was
# found, so the whole blob became Findings_EN and carries indication or age
# wording. Excluded from EVERY arm with the same denominator, or the arms are
# not comparable.
RAC_VOLUME_EXCLUDE=/temp_work/ch278233/LEAKAGE_EXCLUDE.txt

# Separable from RAC_SEED so "same weights, different dropout schedule" is
# expressible as an ablation. Defaults to RAC_SEED when unset.
# RAC_CTX_SEED=0

# ---- evaluation -----------------------------------------------------------
# One of the four conditions: true | none | shuffled. Applied once at dataset
# construction so an evaluation always re-runs to the same number.
RAC_EVAL_IND_MODE=true

# ---- debugging ------------------------------------------------------------
# Asserts Z_ind is finite every step. A NaN there passes straight through the
# zero-initialised fusion block (0 * NaN = NaN) and surfaces looking like an
# image-tower fault. Cheap; leave on until the first full run is clean.
RAC_CTX_DEBUG=0
