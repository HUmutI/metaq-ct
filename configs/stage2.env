# Stage 2 -- region-aware contrastive pretraining (Section 2, "Stage 2").
# This is the configuration that produced the reported ARC-CT numbers.
RAC_TOTAL_UPDATES=14400
RAC_WARMUP_UPDATES=1200
RAC_VAL_EVERY=1200
RAC_SAVE_EVERY=1200
RAC_BATCH_SIZE=20            # batch 32 does not fit in 80 GB
RAC_ACCUM_STEPS=1
RAC_LR=1.1e-5                # vision
RAC_TEXT_LR=1e-6             # text LoRA
RAC_WEIGHT_DECAY=1e-4
RAC_TEXT_WEIGHT_DECAY=1e-4
RAC_MAX_GRAD_NORM=0.5
RAC_EARLY_STOP_PATIENCE=4
RAC_EARLY_STOP_MIN_UPDATES=1000
RAC_MAX_TEXT_LEN=384
RAC_PROMPT_LEN=64
RAC_OPT_DEFER=1

# AnatomyQFormer: 10 anatomy + 18 pathology queries + the remainder as global.
RAC_USE_ANATOMY_QFORMER=1
RAC_USE_QFORMER=0
RAC_QFORMER_QUERIES=30
RAC_QFORMER_DEPTH=4
RAC_QFORMER_HEADS=8
RAC_QFORMER_POOL=mean

# Label-Jaccard soft InfoNCE, per-organ alignment, query supervision.
RAC_FN_WEIGHT=0.3            # alpha in the paper; 0 recovers one-hot InfoNCE
RAC_USE_LEARNABLE_TEMP=1
RAC_LEARNABLE_TEMP_MAX_SCALE=100.0
RAC_USE_TOPK_POOL=1
RAC_TOPK_K=8
RAC_FOCAL_CLASSES="Lung nodule,Atelectasis,Lung opacity,Consolidation"  # quoted: the space made `set -a; . this` assign only "Lung" to a command
                             # that does not exist, leaving the variable EMPTY and top-K focal
                             # pooling silently off despite RAC_USE_TOPK_POOL=1.
RAC_PERTOKEN_NCE_WEIGHT=0.5
RAC_PATHOLOGY_MAP_V2=1
RAC_IMPRESSION_FIRST=1

# Data
RAC_REQUIRE_MASK=1           # Stage 2 trains with organ masks; inference does not
RAC_INTENSITY_JITTER_HU=30
RAC_JITTER_PER_CHANNEL=1
RAC_ENABLE_ANATOMY_FLIPS=0
RAC_RANDOM_CROP=0
RAC_GAUSSIAN_NOISE_SIGMA=0
RAC_HU_LUNG_LO=-1500
RAC_HU_LUNG_HI=500
