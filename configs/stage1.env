# Stage 1 -- supervised image pretraining (Section 2, "Stage 1").
# Trains the 3D ResNet-18 on the 18 LLM-extracted labels; the linear head is
# discarded afterwards and the backbone warm-starts Stage 2.
RAC_STAGE1_EPOCHS=8
RAC_STAGE1_BATCH_SIZE=8
RAC_STAGE1_LR=1e-4
RAC_STAGE1_LOSS=asl          # asymmetric loss, gamma-=4 gamma+=1 m=0.05
RAC_STAGE1_WEIGHT_DECAY=1e-4
RAC_KINETICS_REQUIRED=1      # initialise from Kinetics-400 R3D-18

# Augmentation
RAC_INTENSITY_JITTER_HU=30
RAC_JITTER_PER_CHANNEL=1
RAC_ENABLE_ANATOMY_FLIPS=0
RAC_RANDOM_CROP=0
RAC_GAUSSIAN_NOISE_SIGMA=0

# HU windows: lung / soft tissue / bone
RAC_HU_LUNG_LO=-1500
RAC_HU_LUNG_HI=500
