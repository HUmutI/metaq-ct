# Final BCH pediatric architecture ported from BILTIR_BEST_MODEL_HANDOFF.md.
# Source this after no other stage2 config: every load-bearing value is explicit.

RAC_SCHEMA=peds23
RAC_R3D_ARCH=r2plus1d_18
RAC_KINETICS_PRETRAINED=1
RAC_USE_MULTISCALE=0

# 10 anatomy + 23 pathology + 2 global general queries. Context adds 23 tied
# pathology twins and one clinical query: 59 slots over 36 parameter rows.
RAC_USE_QFORMER=0
RAC_USE_ANATOMY_QFORMER=1
RAC_USE_CONTEXT_QFORMER=1
RAC_QFORMER_QUERIES=35
RAC_QFORMER_DEPTH=4
RAC_QFORMER_HEADS=8
RAC_QFORMER_POOL=mean
RAC_CTX_ANATOMY_QUERIES=1
RAC_SUPPRESS_ROUTING_MASK=0

# C1 + C2 and identity-preserving [I|0] fusion.
RAC_CTX_C1=1
RAC_CTX_C2=1
RAC_CTX_FUSION=concat
RAC_CTX_SELFATTN=split
RAC_CTX_ZIND_COMBINE=mean
RAC_CTX_FILM_EPS=0.2
RAC_CTX_BETA_INIT=-2.0
RAC_CTX_LR_MULT=20
RAC_CTX_WEIGHT_DECAY=0
RAC_CTX_MAX_IND_LEN=64
RAC_CTX_ASSERT_INVARIANCE=1
RAC_CTX_ROLE_STATS=1
RAC_CTX_DEBUG=1
RAC_METADATA_MODE=all
RAC_AGE_MODE=band

# Pediatric indications are available and detailed. 0.30 is the transferred
# default; 0.00/0.10/0.40 are separate controlled arms in the matrix.
RAC_IND_DROPOUT=0.30
RAC_CTX_SEED=0

# Clean paper recipe: prompt inference is primary; no supervised readout or CF.
RAC_CTX_CLS=0
RAC_CTX_CLS_WEIGHT=0.5
RAC_CTX_SEPARATE_IND_LOSS=1
RAC_CTX_W_IND=2.0
RAC_CF_PROB=0
RAC_CF_WEIGHT=0
RAC_CTX_PTOK_WEIGHT=0
RAC_VAL_SELECTION=conditioned

# Biltir prompt recipe.
RAC_PROMPT_NEGATIVE=null
RAC_NO_L2_CLIP=1
RAC_NO_L2_PROMPT=1
RAC_TEMPERATURE=1.0
RAC_USE_LEARNABLE_TEMP=0
RAC_CLIP_WEIGHT=1.0
RAC_CLS_WEIGHT=0.5
RAC_ALIGN_WEIGHT=0.5
RAC_PERTOKEN_NCE_WEIGHT=0.5
RAC_FN_WEIGHT=0.3

# Optimisation. At most 10k updates, with conditioned-AUC early stopping.
RAC_BATCH_SIZE=4
RAC_ACCUM_STEPS=8
RAC_LR=1e-5
RAC_TEXT_LR=1e-7
RAC_WEIGHT_DECAY=1e-4
RAC_TEXT_WEIGHT_DECAY=1e-3
RAC_MAX_GRAD_NORM=0.5
RAC_OPT_DEFER=1
RAC_AMP=1
RAC_TOTAL_UPDATES=10000
RAC_WARMUP_UPDATES=500
RAC_VAL_EVERY=500
# Best checkpoints are written whenever development AUROC improves. Avoid
# redundant 1.3-GiB periodic copies; they previously exhausted the work quota
# and killed the ablation dependency graph.
RAC_SAVE_EVERY=10000
RAC_EARLY_STOP_PATIENCE=6
RAC_EARLY_STOP_MIN_UPDATES=3000
RAC_PROMPT_CACHE_EVERY=50
RAC_NUM_WORKERS=6

# Biltir Stage-2 preprocessing. Pediatric organ routing comes from peds schema,
# not the adult pathology-map override.
RAC_RANDOM_CROP=1
RAC_ENABLE_ANATOMY_FLIPS=1
RAC_INTENSITY_JITTER_HU=20
RAC_JITTER_PER_CHANNEL=0
RAC_GAUSSIAN_NOISE_SIGMA=0
RAC_HU_WINDOW_JITTER=0
RAC_MASK_DROPOUT=0
RAC_PAD_HU=0
RAC_HU_LUNG_LO=-1000
RAC_HU_LUNG_HI=400
RAC_HU_SOFT_LO=-160
RAC_HU_SOFT_HI=240
RAC_HU_BONE_LO=300
RAC_HU_BONE_HI=2000
RAC_IMPRESSION_FIRST=0
RAC_MAX_TEXT_LEN=256
RAC_PROMPT_LEN=64
RAC_REQUIRE_MASK=1
RAC_PATHOLOGY_MAP_V2=0
RAC_USE_TOPK_POOL=0
RAC_FOCAL_ALIGN=0
