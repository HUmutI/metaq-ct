# Pediatric stage-2. Same optimisation recipe as the adult run; only the schema,
# the data paths and the things measured on this cohort differ.
#
# Everything not commented is copied verbatim from stage2.env so the two runs
# stay comparable - if the pediatric number moves, it should be because of the
# data and the schema, not because a learning rate drifted.

RAC_SCHEMA=peds                 # 27 labels, 10 pediatric regions
RAC_QFORMER_QUERIES=39          # 10 anatomy + 27 pathology + 2 global

# 7042 training studies vs CT-RATE's ~47k, so a full pass is ~6.7x cheaper.
# Keep the same batch and LR; cut the schedule and evaluate more often so early
# stopping can actually fire before the budget runs out.
RAC_TOTAL_UPDATES=6000
RAC_WARMUP_UPDATES=500
RAC_VAL_EVERY=400
RAC_SAVE_EVERY=400
RAC_EARLY_STOP_PATIENCE=5
RAC_EARLY_STOP_MIN_UPDATES=800

RAC_BATCH_SIZE=20
RAC_ACCUM_STEPS=1
RAC_LR=1.1e-5
RAC_TEXT_LR=1e-6
RAC_WEIGHT_DECAY=1e-4
RAC_TEXT_WEIGHT_DECAY=1e-4
RAC_MAX_GRAD_NORM=0.5
RAC_MAX_TEXT_LEN=384
RAC_PROMPT_LEN=64
RAC_OPT_DEFER=1

RAC_USE_ANATOMY_QFORMER=1
RAC_USE_QFORMER=0
RAC_QFORMER_DEPTH=4
RAC_QFORMER_HEADS=8
RAC_QFORMER_POOL=mean

RAC_FN_WEIGHT=0.3
RAC_USE_LEARNABLE_TEMP=1
RAC_LEARNABLE_TEMP_MAX_SCALE=100.0
RAC_USE_TOPK_POOL=1
RAC_TOPK_K=8
RAC_PERTOKEN_NCE_WEIGHT=0.5

# These three were in the adult recipe and were dropped here by accident, which
# contradicts this file's own header. Measured on reports_arcct.csv: 11.6% of
# pediatric reports have findings alone longer than the 384-token budget, so
# without IMPRESSION_FIRST the impression - the diagnostic conclusion - is
# truncated away entirely in one report in nine. And dropping the jitter left a
# dataset 6.7x smaller than CT-RATE's with no intensity augmentation at all.
RAC_IMPRESSION_FIRST=1
RAC_INTENSITY_JITTER_HU=30
RAC_JITTER_PER_CHANNEL=1

# Without this train_stage2 leaves its generator unseeded: no torch.manual_seed,
# unseeded DataLoader workers, and a multi-day run nobody can reproduce.
RAC_SEED=0

# Focal classes chosen from THIS cohort's prevalence, not the adult list.
# Lung nodule 54%, Lung opacity 29%, Atelectasis 33% and Post-surgical change
# 36% are the four most common findings in these 8817 reports.
# Quoted on purpose: unquoted, `set -a; . file` parses this as the assignment
# RAC_FOCAL_CLASSES=Lung followed by the command `nodule,Atelectasis,Lung`, which
# fails harmlessly and leaves the variable UNSET - so the adult default silently
# applies instead. stage2.env has the same bug; there the fallback happens to
# equal the intent, which is why nobody noticed.
RAC_FOCAL_CLASSES="Lung nodule,Atelectasis,Lung opacity,Post-surgical or post-treatment change"

# PATHOLOGY_MAP_V2 is an adult-only remedy (it rerouted Lymphadenopathy,
# Emphysema and Pulmonary fibrotic sequela). The pediatric routing table in
# arcct/schema.py already encodes those decisions, so leave this off or it would
# overwrite them.
RAC_PATHOLOGY_MAP_V2=0

# Windows must match what the checkpoint was trained with. The code default is
# -1000/400, which is NOT what produced 0.8524.
RAC_HU_LUNG_LO=-1500
RAC_HU_LUNG_HI=500

RAC_REQUIRE_MASK=1              # fail loudly rather than train anatomy-free
